{
  "name": "@r_masseater/vocablint",
  "version": "0.0.0",
  "private": true,
  "description": "Point every finite value set and object shape at the one place that already owns it: a registered owner in the repository or a dependency type.",
  "keywords": [
    "effect",
    "lint",
    "typescript",
    "vocabulary"
  ],
  "homepage": "https://github.com/masseater/lint-kit/tree/main/tools/vocablint#readme",
  "bugs": {
    "url": "https://github.com/masseater/lint-kit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/lint-kit.git",
    "directory": "tools/vocablint"
  },
  "bin": {
    "vocablint": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint.d.mts",
      "default": "./dist/oxlint.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:stack"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@vocablint/core": "workspace:*",
    "typescript": "catalog:stack",
    "vite-plus": "catalog:stack",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=7.1.0-beta"
  },
  "engines": {
    "node": ">=26"
  }
}
