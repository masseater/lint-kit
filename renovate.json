{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "automerge": true,
  "ignoreTests": true,
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchPackageNames": [
        "effect",
        "@effect/**",
        "!@effect/tsgo",
        "alchemy",
        "@alchemy.run/**",
        "@distilled.cloud/**"
      ],
      "groupName": "effect and alchemy"
    },
    {
      "matchDepTypes": ["pnpm-workspace.overrides"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "!/-dev\\./"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["masseater/typescript-template"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "uses: (?<depName>masseater/typescript-template)/\\.github/actions/[a-z-]+@(?<currentDigest>[0-9a-f]{40})"
      ],
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    }
  ]
}
