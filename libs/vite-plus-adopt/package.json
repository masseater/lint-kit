{
  "name": "@r_masseater/vite-plus-adopt",
  "version": "0.2.0",
  "description": "Adopt Betterleaks, actionlint, zizmor, commitlint, textlint, Steiger and dependency checks into Vite+ through the settings in vite.config.ts, and ship the Feature-Sliced Design Steiger plugin and @arethetypeswrong/core for TypeScript 7.",
  "keywords": [
    "actionlint",
    "arethetypeswrong",
    "attw",
    "betterleaks",
    "commitlint",
    "feature-sliced",
    "steiger",
    "textlint",
    "vite-plus",
    "zizmor"
  ],
  "homepage": "https://github.com/masseater/lint-kit/tree/main/libs/vite-plus-adopt#readme",
  "bugs": {
    "url": "https://github.com/masseater/lint-kit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/lint-kit.git",
    "directory": "libs/vite-plus-adopt"
  },
  "bin": {
    "vpa": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES"
  ],
  "type": "module",
  "imports": {
    "#attw-upstream/*": "./upstream/attw-core/lib/*",
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./fsd": {
      "types": "./dist/fsd.d.mts",
      "default": "./dist/fsd.mjs"
    },
    "./attw": {
      "types": "./dist/attw.d.mts",
      "default": "./dist/attw.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp run build",
    "postinstall": "node -e \"require('fs').existsSync('dist/postinstall.mjs') && import('./dist/postinstall.mjs')\""
  },
  "dependencies": {
    "@andrewbranch/untar.js": "1.0.4",
    "@commitlint/format": "21.2.3",
    "@commitlint/lint": "21.2.4",
    "@commitlint/load": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@effect/platform-node": "catalog:",
    "@loaderkit/resolve": "1.0.6",
    "@textlint/config-loader": "15.8.0",
    "@textlint/kernel": "15.8.0",
    "cjs-module-lexer": "1.4.3",
    "effect": "catalog:stack",
    "fastest-levenshtein": "1.0.16",
    "fflate": "0.8.3",
    "markdownlint": "catalog:",
    "minimatch": "11.0.3",
    "pluralize": "8.0.0",
    "semver": "7.8.6",
    "smol-toml": "1.9.1",
    "steiger": "0.9.0",
    "textlint": "15.8.0",
    "tsconfck": "3.1.6",
    "typescript": "catalog:stack",
    "validate-npm-package-name": "5.0.1",
    "web-tree-sitter": "0.26.13",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@feature-sliced/filesystem": "3.1.1",
    "@feature-sliced/steiger-plugin": "0.8.2",
    "@size-limit/file": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "catalog:stack",
    "size-limit": "catalog:",
    "vite": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "vite": "*",
    "vite-plus": ">=1.5.0"
  },
  "size-limit": [
    {
      "name": "tools",
      "path": [
        "dist/*.mjs",
        "!dist/fsd.mjs",
        "!dist/attw.mjs"
      ],
      "limit": "9887 B"
    },
    {
      "name": "fsd",
      "path": "dist/fsd.mjs",
      "limit": "9364 B"
    },
    {
      "name": "attw",
      "path": "dist/attw.mjs",
      "limit": "45833 B"
    }
  ],
  "engines": {
    "node": ">=26"
  }
}
