{
  "name": "@r_masseater/attw-core",
  "version": "0.1.4",
  "description": "Run @arethetypeswrong/core on TypeScript 7 alone, as a drop-in replacement that tsdown and Vite+ load through a package manager override.",
  "keywords": [
    "arethetypeswrong",
    "attw",
    "tsdown",
    "typescript",
    "vite-plus"
  ],
  "homepage": "https://github.com/masseater/lint-kit/tree/main/libs/attw-core#readme",
  "bugs": {
    "url": "https://github.com/masseater/lint-kit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/lint-kit.git",
    "directory": "libs/attw-core"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./problems": {
      "types": "./dist/problems.d.mts",
      "default": "./dist/problems.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "default": "./dist/types.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "default": "./dist/utils.mjs"
    },
    "./versions": {
      "types": "./dist/versions.d.mts",
      "default": "./dist/versions.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@andrewbranch/untar.js": "1.0.4",
    "@loaderkit/resolve": "1.0.6",
    "cjs-module-lexer": "1.4.3",
    "effect": "catalog:stack",
    "fflate": "0.8.3",
    "semver": "7.8.6",
    "typescript": "catalog:stack",
    "validate-npm-package-name": "5.0.1"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@size-limit/file": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "catalog:stack",
    "attw-core-upstream": "npm:@arethetypeswrong/core@0.18.5",
    "size-limit": "catalog:",
    "vite": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "size-limit": [
    {
      "name": "core",
      "path": [
        "dist/*.mjs"
      ],
      "limit": "51595 B"
    }
  ],
  "engines": {
    "node": ">=26"
  }
}
