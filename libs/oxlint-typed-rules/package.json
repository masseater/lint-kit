{
  "name": "@r_masseater/oxlint-typed-rules",
  "version": "0.1.1",
  "description": "Run ESLint rules that need type information as oxlint JS plugins on TypeScript 7, including TanStack Start's React Server Component rules and ESLint React.",
  "keywords": [
    "eslint",
    "eslint-react",
    "oxlint",
    "oxlint-plugin",
    "react",
    "tanstack-start",
    "typescript"
  ],
  "homepage": "https://github.com/masseater/lint-kit/tree/main/libs/oxlint-typed-rules#readme",
  "bugs": {
    "url": "https://github.com/masseater/lint-kit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/lint-kit.git",
    "directory": "libs/oxlint-typed-rules"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./tanstack-start": "./src/tanstack-start.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./react": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "./tanstack-start": {
        "types": "./dist/tanstack-start.d.mts",
        "default": "./dist/tanstack-start.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "effect": "catalog:stack"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@size-limit/file": "catalog:",
    "@tanstack/eslint-plugin-start": "catalog:",
    "@tsconfig/strictest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@typescript-eslint/types": "catalog:",
    "@typescript-eslint/typescript-estree": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "dedent": "catalog:",
    "publint": "catalog:",
    "size-limit": "catalog:",
    "typescript": "catalog:stack",
    "vite-plus": "catalog:stack"
  },
  "peerDependencies": {
    "typescript": ">=7.1.0-beta"
  },
  "size-limit": [
    {
      "name": "react",
      "path": "dist/react.mjs",
      "limit": "170642 B"
    },
    {
      "name": "core",
      "path": [
        "dist/*.mjs",
        "!dist/react.mjs"
      ],
      "limit": "26452 B"
    }
  ],
  "engines": {
    "node": ">=26"
  }
}
